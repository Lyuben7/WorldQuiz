@model IReadOnlyList<QuizLab.Models.Quiz>
@{ ViewData["Title"] = "Избери тема"; }
<section class="catalog">
<p class="eyebrow">ТВОЯТА СЛЕДВАЩА СТЪПКА</p>
<h1 class="page-title">Какво ще научиш <span>днес?</span></h1>
<p class="intro">Избери тема, провери знанията си и превърни грешките в напредък.</p>
<div class="catalog-meta">@Model.Count теми · @Model.Sum(q => q.Questions.Count) въпроса · Един верен отговор</div>
<div class="topic-grid">
@for (var i = 0; i < Model.Count; i++) {
var quiz = Model[i];
<article class="topic-card">
<span class="topic-number">@((i + 1).ToString("00")) / QUIZ</span>
<h2>@quiz.Title</h2><p>@quiz.Questions.Count въпроса · Провери знанията си</p>
<div class="topic-links"><a class="btn start-btn" asp-controller="Quiz" asp-action="Play" asp-route-id="@quiz.Id">Започни ↗</a>
<a class="shuffle-link" asp-controller="Quiz" asp-action="Play" asp-route-id="@quiz.Id" asp-route-shuffle="true">Разбъркай</a></div>
</article>
}
</div></section>

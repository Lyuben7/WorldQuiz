@model QuizLab.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Вход"; }
<section class="account-page">
<p class="eyebrow">РАДВАМ СЕ ДА ТЕ ВИДЯ ОТНОВО</p><h1 class="page-title">Вход в профила</h1>
<form asp-action="Login" method="post" class="quiz-card account-card">
<input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="form-errors"></div>
<div class="account-field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
<div class="account-field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password"></span></div>
<button class="btn start-btn" type="submit">Влез ↗</button>
<p class="account-switch">Нямаш профил? <a asp-action="Register">Регистрация</a></p>
</form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@model QuizLab.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Регистрация"; }
<section class="account-page">
<p class="eyebrow">ЗАПАЗИ НАПРЕДЪКА СИ</p><h1 class="page-title">Създай профил</h1>
<p class="intro">Резултатите от завършените куизи ще се пазят в профила ти.</p>
<form asp-action="Register" method="post" class="quiz-card account-card">
<div asp-validation-summary="ModelOnly" class="form-errors"></div>
<div class="account-field"><label asp-for="UserName"></label><input asp-for="UserName" autocomplete="username" /><span asp-validation-for="UserName"></span></div>
<div class="account-field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div>
<div class="account-field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></div>
<div class="account-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
<button class="btn start-btn" type="submit">Регистрирай се ↗</button>
<p class="account-switch">Вече имаш профил? <a asp-action="Login">Вход</a></p>
</form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

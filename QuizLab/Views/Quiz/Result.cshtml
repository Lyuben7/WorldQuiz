@model QuizLab.ViewModels.QuizResultViewModel
@{
    ViewData["Title"] = "Резултат";
}

<div class="quiz-screen">
    <h1 class="page-title">Резултат</h1>
    <div class="quiz-card result-summary" data-celebrate="@((Model.Total > 0 && Model.Score * 100 >= Model.Total * 70) ? "true" : "false")">
        <p class="quiz-subtitle">@Model.Title</p>
        <p class="quiz-score">@Model.Score / @Model.Total</p>
<p>@(Model.Total > 0 ? (int)Math.Round(100.0 * Model.Score / Model.Total) : 0)% верни отговори</p>
<p>@(Model.Total > 0 && Model.Score * 100 >= Model.Total * 70 ? "Браво! Знанията ти заслужават конфети!" : "Всяка грешка е нов урок. Прегледай отговорите и опитай пак.")</p>
        @if (Model.SavedToProfile) { <p class="saved-note">✓ Резултатът е запазен в профила ти.</p> }
        else { <p class="saved-note">Искаш да пазиш резултатите си? <a asp-controller="Account" asp-action="Register">Създай профил</a> или <a asp-controller="Account" asp-action="Login">влез</a>.</p> }
        <a class="btn start-btn" asp-controller="Quiz" asp-action="Play" asp-route-id="@Model.Id" asp-route-shuffle="true">Опитай отново</a>
        <a class="btn continent-btn na-btn ms-2" asp-controller="Home" asp-action="Hello">Друга тема</a>
    </div>

    <div class="quiz-results">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            var item = Model.Items[i];
            <article class="quiz-card quiz-result-card @(item.IsCorrect ? "is-correct" : "is-wrong")">
                <h2>@(i + 1). @item.Text</h2><p>@(item.IsCorrect ? "✓ Верен отговор" : "✕ Неверен отговор")</p>
                <ul>
                    @for (var optionIndex = 0; optionIndex < item.Options.Count; optionIndex++)
                    {
                        var css = optionIndex == item.CorrectIndex
                            ? "correct-option"
                            : optionIndex == item.SelectedIndex
                                ? "selected-option"
                                : "";
                        <li class="@css">@item.Options[optionIndex] @(optionIndex == item.CorrectIndex ? " — верен отговор" : optionIndex == item.SelectedIndex ? " — твоят отговор" : "")</li>
                    }
                </ul>
                @if (item.SelectedIndex < 0)
                {
                    <p class="quiz-note">Няма избран отговор.</p>
                }
            </article>
        }
    </div>
</div>
